// greencode - schema Prisma (PostgreSQL)
// Todos os modelos de negocio possuem o campo "versao" (bloqueio otimista).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

/// Substitui Credencial/Sessao do CLI: autenticacao agora e stateless (JWT).
model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  usuario      String       @unique
  senhaHash    String
  papel        PapelUsuario
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  versao       Int          @default(1)

  @@map("usuarios")
}

model Organizacao {
  id                String   @id @default(uuid()) @db.Uuid
  razaoSocial       String
  cnpj              String   @unique @db.VarChar(14)
  inscricaoEstadual String   @default("")
  enderecoCompleto  String   @default("")
  telefone          String   @default("")
  email             String   @default("")
  ativo             Boolean  @default(true)
  dataCadastro      DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  versao            Int      @default(1)

  /// Uma organizacao possui um contrato opcional...
  contrato Contrato?
  /// ...e muitos lotes.
  lotes    Lote[]
  /// Parceiros externos (API publica) vinculados a esta organizacao.
  parceiros Parceiro[]

  @@map("organizacoes")
}

model Contrato {
  id                  String      @id @default(uuid()) @db.Uuid
  organizacaoId       String      @unique @db.Uuid
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  dataAssinatura      DateTime    @default(now())
  dataVencimento      DateTime
  /// JSON (string[]) - dado semiestruturado, como sugerido no enunciado.
  clausulas           Json        @default("[]")
  valorMensal         Decimal     @db.Decimal(12, 2)
  renovacaoAutomatica Boolean     @default(false)
  atualizadoEm        DateTime    @updatedAt
  versao              Int         @default(1)

  @@map("contratos")
}

model Lote {
  id                  String      @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime
  organizacaoId       String      @db.Uuid
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote  @default(RECEBIDO)
  observacoes         String      @default("")
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt
  versao              Int         @default(1)

  equipamentos Equipamento[]

  @@unique([organizacaoId, notaFiscal])
  @@index([organizacaoId])
  @@index([dataEntrada])
  @@index([statusProcessamento])
  @@map("lotes")
}

model Equipamento {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Sequencia global (autoincrement) usada para compor o codigo de barras sem colisao.
  sequencia           Int                @unique @default(autoincrement())
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Decimal            @db.Decimal(8, 3)
  loteId              String             @db.Uuid
  lote                Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
  versao              Int                @default(1)

  movimentacoes Movimentacao[]

  @@unique([loteId, posicaoNoLote])
  @@index([loteId])
  @@index([statusRastreamento])
  @@map("equipamentos")
}

model Movimentacao {
  id            String      @id @default(uuid()) @db.Uuid
  equipamentoId String      @db.Uuid
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")

  @@index([equipamentoId, dataHora])
  @@map("movimentacoes")
}

/// Journal de auditoria (substitui o journal em arquivo do CLI). Gravado na MESMA
/// transacao da operacao de negocio: se a operacao falha, o journal tambem nao persiste.
model JournalTransacao {
  id                 String   @id @default(uuid()) @db.Uuid
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  entidadeId         String?
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String

  @@index([timestamp])
  @@index([entidade, entidadeId])
  @@index([usuarioResponsavel])
  @@map("journal_transacoes")
}

/// Parametros globais (aliquota de imposto, coeficiente de depreciacao...) - papel ADMINISTRADOR.
model Parametro {
  chave        String   @id
  valor        Json
  atualizadoEm DateTime @updatedAt

  @@map("parametros")
}


// =====================================================================================
// ATIVIDADE 3 - camada analitica, API publica (chaves) e fila de tarefas
// =====================================================================================

enum EscopoApi {
  RASTREABILIDADE_LER
  LOTES_LER
  LOTES_ESCREVER
  ANALISES_LER
}

enum TipoAnalise {
  EFICIENCIA
  RENTABILIDADE
  VIDA_UTIL
}

enum OrigemAnalise {
  AGENDADA
  MANUAL
}

enum TipoTarefa {
  EXECUTAR_ANALISE
  GERAR_RELATORIO
}

enum StatusTarefa {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDA
  FALHA
}

/// Parceiro externo que consome a API publica.
model Parceiro {
  id            String       @id @default(uuid()) @db.Uuid
  nome          String       @unique
  email         String
  /// Escopo de dados: o parceiro so enxerga dados desta organizacao.
  organizacaoId String?      @db.Uuid
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  /// Visao agregada (todas as organizacoes). Precisa ser concedida EXPLICITAMENTE.
  acessoGlobal  Boolean      @default(false)
  ativo         Boolean      @default(true)
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  chaves  ChaveApi[]
  tarefas Tarefa[]

  @@map("parceiros")
}

/// Chave de API. O segredo em texto puro NUNCA e armazenado: apenas SHA-256 (hashChave).
model ChaveApi {
  id              String      @id @default(uuid()) @db.Uuid
  parceiroId      String      @db.Uuid
  parceiro        Parceiro    @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  nome            String
  /// Trecho publico da chave (localiza o registro sem varrer a tabela).
  prefixo         String      @unique @db.VarChar(16)
  hashChave       String
  escopos         EscopoApi[]
  limitePorMinuto Int         @default(60)
  ativo           Boolean     @default(true)
  expiraEm        DateTime?
  ultimoUsoEm     DateTime?
  criadoEm        DateTime    @default(now())
  revogadaEm      DateTime?

  tarefas Tarefa[]

  @@index([parceiroId])
  @@map("chaves_api")
}

/// Historico (snapshots) dos resultados analiticos, para consulta historica e comparacao.
model ResultadoAnalise {
  id            String        @id @default(uuid()) @db.Uuid
  tipo          TipoAnalise
  origem        OrigemAnalise
  /// null = analise global
  organizacaoId String?       @db.Uuid
  periodoInicio DateTime?
  periodoFim    DateTime?
  versaoModelo  String
  parametros    Json
  resultado     Json
  duracaoMs     Int
  geradoEm      DateTime      @default(now())

  previsoes PrevisaoVidaUtil[]

  @@index([tipo, geradoEm])
  @@index([organizacaoId])
  @@map("resultados_analise")
}

/// Parametros do modelo de regressao por tipo de equipamento, em cada execucao (series temporais do modelo).
model PrevisaoVidaUtil {
  id                        String           @id @default(uuid()) @db.Uuid
  analiseId                 String           @db.Uuid
  analise                   ResultadoAnalise @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  tipoEquipamento           TipoEquipamento
  amostra                   Int
  intercepto                Float
  inclinacao                Float
  r2                        Float
  /// Erro (RMSE) em amostra reservada (holdout); null quando a amostra e pequena.
  rmse                      Float?
  idadeInservivelEstimada   Float?
  vidaRemanescenteMediaAnos Float?
  status                    String
  geradoEm                  DateTime         @default(now())

  @@index([tipoEquipamento, geradoEm])
  @@index([analiseId])
  @@map("previsoes_vida_util")
}

/// Valor de recuperacao de materiais (R$/kg). marca/modelo vazios = "qualquer".
/// Precedencia na estimativa: (tipo+marca+modelo) > (tipo+marca) > (tipo) > padrao.
model ValorReferencia {
  id           String          @id @default(uuid()) @db.Uuid
  tipo         TipoEquipamento
  marca        String          @default("")
  modelo       String          @default("")
  valorPorKg   Decimal         @db.Decimal(10, 2)
  atualizadoEm DateTime        @updatedAt

  @@unique([tipo, marca, modelo])
  @@map("valores_referencia")
}

/// Fila de tarefas assincronas (processamento em segundo plano) sobre o proprio PostgreSQL.
model Tarefa {
  id                String       @id @default(uuid()) @db.Uuid
  tipo              TipoTarefa
  status            StatusTarefa @default(PENDENTE)
  payload           Json
  resultado         Json?
  /// Conteudo do arquivo gerado (CSV/JSON) para tarefas de relatorio.
  conteudo          String?
  nomeArquivo       String?
  mime              String?
  tentativas        Int          @default(0)
  maxTentativas     Int          @default(3)
  proximaExecucaoEm DateTime     @default(now())
  travadaEm         DateTime?
  travadaPor        String?
  erro              String?
  parceiroId        String?      @db.Uuid
  parceiro          Parceiro?    @relation(fields: [parceiroId], references: [id], onDelete: SetNull)
  chaveApiId        String?      @db.Uuid
  chaveApi          ChaveApi?    @relation(fields: [chaveApiId], references: [id], onDelete: SetNull)
  solicitante       String
  criadoEm          DateTime     @default(now())
  iniciadaEm        DateTime?
  concluidaEm       DateTime?
  expiraEm          DateTime?

  @@index([status, proximaExecucaoEm])
  @@index([parceiroId, criadoEm])
  @@map("tarefas")
}
